.flex.flex-col.gap-2
  = form_with url: statistics_path, method: :get, class: "flex flex-col md:flex-row gap-2" do |f|
    .flex.gap-2.items-center
      = f.label :from, t("statistics.show.filters.from")
      = f.date_field :from, value: @from, class: "w-full md:w-fit"
    .flex.gap-2.items-center.w-full
      = f.label :to, t("statistics.show.filters.to")
      = f.date_field :to, value: @to, class: "w-full md:w-fit"
    .text-center.bg-primary= f.submit t('common.apply')
  .flex.gap-2.flex-col.md:flex-row
    = link_to statistics_path(from: Date.current, to: Date.current), class: "border-3 md:w-fit #{"bg-primary" if filtered_on_today?}" do
      = t("statistics.show.filters.today")
    = link_to statistics_path(from: Date.current.beginning_of_month, to: Date.current.end_of_month), class: "border-3 md:w-fit #{"bg-primary" if filtered_on_month?}" do
      = t("statistics.show.filters.this_month")
    = link_to statistics_path(from: Date.current.beginning_of_year, to: Date.current.end_of_year), class: "border-3 md:w-fit #{"bg-primary" if filtered_on_year?}" do
      = t("statistics.show.filters.this_year")