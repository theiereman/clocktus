
= content_for :title, t(".title")

= turbo_frame_tag "stats", class: "flex flex-col gap-12" do
  .flex.items-center.justify-between
    %h1= t(".title")
    - if @shareable
      = button_to user_profile_link_path, class: "flex gap-2 items-center" do
        = lucide_icon "share-2", class: "size-4"
        .hidden.md:block= t(".share")

  = render "ui/container", title: t('.filters.title') do 
    = render "statistics/filters"

  #global
    .flex.gap-1.items-baseline.mb-4
      %h2= t(".global")
      .opacity-60.text-sm= t(".not_affected_by_filters")

    .mb-6.flex.gap-3.flex-col.md:flex-row
      = render "statistics/global_block", title: t(".signup_date") , value: l(@user_signup_date)
      = render "statistics/global_block", title: t(".number_of_days_since_signup") , value: @number_of_dates_since_user_signup
      = render "statistics/global_block", title: t(".activities_registered") , value: @number_of_activities
      = render "statistics/global_block", title: t(".days_completed") , value: @days_completed

  #activities-per-category{ data: { controller: "chart-legend", chart_legend_resize_on_hide_value: true } }
    %h2.mb-4= t(".activities_per_category")
    .mb-2
      = column_chart @count_per_category, legend: false, library: { grouped: false, scales: { x: { ticks: { display: false } } }, interaction: { mode: "nearest", intersect: true } }

    - unless @top_categories.empty?
      .overflow-x-auto
        %table.w-full.text-sm
          %thead
            %tr.border-b.border-gray-200.text-left.text-gray-500
              %th.py-2.pr-4.font-medium= t(".table.category")
              %th.py-2.pr-4.font-medium.text-right= t(".table.hours")
              %th.py-2.font-medium.text-right= t(".table.percentage")
          %tbody
            - @top_categories.each_with_index do |row, index|
              %tr.border-b.border-gray-100.cursor-pointer.select-none{ data: { chart_legend_target: "row", chart_legend_index_param: index, action: "mouseenter->chart-legend#rowHover mouseleave->chart-legend#rowLeave click->chart-legend#rowClick" } }
                %td.py-2.pr-4
                  .flex.items-center.gap-2
                    %span.inline-block.size-4.border-3.border-text.shrink-0{ style: "background-color: #{row[:color]}" }
                    = row[:label]
                %td.py-2.pr-4.text-right= row[:count]
                %td.py-2.text-right= "#{row[:percentage]}%"

  - unless single_day?
    #activities-over-time
      %h2.mb-4= t(".activities_over_time")
      .mb-6{ data: { controller: "chart-legend" } }
        = line_chart @hours_per_category_over_time, legend: :bottom, dataset: { tension: 0.3 }

    - unless @mood_over_time.empty?
      #mood-over-time
        %h2.mb-4= t(".mood_over_time")
        .mb-6{ data: { controller: "mood-chart", mood_chart_labels_value: @mood_level_labels } }
          = line_chart @mood_over_time, legend: false, colors: [ "#ffb900" ], dataset: { tension: 0.3 }, library: { scales: { y: { min: 0, max: @mood_level_labels.size - 1 } } }

    #activities-over-time-per-category
      %h2.mb-4= t(".activities_over_time_per_category")
      .my-6.grid.grid-cols-1.gap-6{ class: "sm:grid-cols-2 lg:grid-cols-3" }
        - @hours_per_category_over_time.each do |series|
          .rounded-lg.border.border-gray-200.p-4
            .mb-2.flex.items-center.gap-2
              %span.inline-block.size-4.border-3.border-text.shrink-0{ style: "background-color: #{series[:color]}" }
              %span.text-sm.font-medium= series[:name]
            = line_chart [ series ], height: "160px", legend: false, dataset: { tension: 0.3 }

