-# locals: (date:, comment:)
%h2.mb-2= t(".title")
.flex
  = form_with model: comment, url: comments_path, method: :post, class: "w-full" do |f|
    = f.hidden_field :date, value: date
    = f.text_area :body, rows: 4, placeholder: t(".placeholder"), data: { controller: "autosubmit", action: "blur->autosubmit#submit" }, class: "w-full"